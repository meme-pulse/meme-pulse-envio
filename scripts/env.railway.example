# =============================================================================
# Meme Pulse Envio - Railway Environment Variables
# =============================================================================
# Copy this file and set your values before running deploy-railway.sh
#
# Usage:
#   cp scripts/env.railway.example scripts/env.railway
#   source scripts/env.railway
#   ./scripts/deploy-railway.sh
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database URL (Required)
# -----------------------------------------------------------------------------
# Format: postgres://user:password@host:port/database
# Get this from Railway PostgreSQL service after deployment
export DATABASE_URL="postgres://postgres:your-password@your-host.railway.app:5432/railway"

# -----------------------------------------------------------------------------
# Hasura Admin Secret (Required for production)
# -----------------------------------------------------------------------------
# Used to secure the Hasura GraphQL console and API
# Generate a strong random string for production
export HASURA_ADMIN_SECRET="your-secure-admin-secret"

# -----------------------------------------------------------------------------
# Optional: Override defaults
# -----------------------------------------------------------------------------
# export LOG_LEVEL="trace"           # trace, debug, info, warn, error
# export LOG_STRATEGY="console-pretty" # console-pretty, console-json

